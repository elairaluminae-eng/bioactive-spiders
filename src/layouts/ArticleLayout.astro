---
interface Props {
  content?: {
    title: string;
    description: string;
    pubDate: string;
    updatedDate?: string;
    category: string;
    tags?: string[];
    schemaType?: string;
  };
  frontmatter?: Props['content'];
}

const { frontmatter, content } = Astro.props;
const data = frontmatter || content;

if (!data) {
  throw new Error("No frontmatter provided to ArticleLayout");
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://bioactive-spiders.pages.dev');
const publishDate = new Date(data.pubDate).toISOString();

const schemaJson = {
  "@context": "https://schema.org",
  "@type": data.schemaType || "Article",
  "headline": data.title,
  "description": data.description,
  "datePublished": publishDate,
  "dateModified": data.updatedDate ? new Date(data.updatedDate).toISOString() : publishDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.title} | Bioactive Spiders</title>
    <meta name="description" content={data.description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Фавикон во вкладке браузера -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🕷️</text></svg>" />

    <!-- Open Graph -->
    <meta property="og:title" content={data.title} />
    <meta property="og:description" content={data.description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="article" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

    <style>
      :root {
        --text-main: #27272a;
        --text-muted: #52525b;
        --forest-dark: #064e3b;
        --forest-accent: #15803d;
        --forest-light: #ecfdf5;
        --border: #e4e4e7;
        --bg-page: #fbfbfa;
        --bg-card: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 1.125rem;
        line-height: 1.85;
        letter-spacing: 0.01em;
        color: var(--text-main);
        background: var(--bg-page);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* Верхняя шапка */
      .site-header {
        background: var(--forest-dark);
        color: #ffffff;
        padding: 1.15rem 1.5rem;
        box-shadow: 0 4px 14px rgba(6, 78, 59, 0.2);
      }
      .header-container {
        max-width: 860px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 1.15rem;
        text-decoration: none;
        color: #ffffff;
      }

      /* Просторный светящийся постамент для паучка */
      .brand-spider-badge {
        width: 56px;
        height: 56px;
        background: radial-gradient(circle, #ffffff 32%, #dcfce7 65%, rgba(6, 78, 59, 0.3) 100%);
        border: 2px solid rgba(52, 211, 153, 0.7);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 16px rgba(255, 255, 255, 0.3), 0 0 10px rgba(52, 211, 153, 0.35);
        flex-shrink: 0;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      }

      /* Крупный выразительный паучок */
      .spider-glyph {
        font-size: 2.15rem;
        line-height: 1;
        display: block;
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
      }

      /* Интерактивный ховер */
      .brand:hover .brand-spider-badge {
        background: radial-gradient(circle, #ffffff 42%, #bbf7d0 75%, rgba(6, 78, 59, 0.2) 100%);
        border-color: #34d399;
        box-shadow: 0 0 24px rgba(255, 255, 255, 0.6), 0 0 14px rgba(52, 211, 153, 0.5);
        transform: scale(1.06);
      }
      .brand:hover .spider-glyph {
        transform: scale(1.15) translateY(-2px);
        filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.35)) brightness(1.22);
      }

      /* Тонкий деликатный разделитель */
      .brand-divider {
        width: 1px;
        height: 32px;
        background: rgba(255, 255, 255, 0.22);
      }

      .brand-text-block {
        display: flex;
        flex-direction: column;
      }
      .brand-title {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.15;
      }
      .brand-tagline {
        font-size: 0.72rem;
        color: #6ee7b7;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 600;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
        font-size: 0.95rem;
        font-weight: 500;
      }
      .nav-links a {
        color: #d1fae5;
        text-decoration: none;
        transition: color 0.15s;
      }
      .nav-links a:hover {
        color: #ffffff;
      }

      /* Контейнер страницы */
      .page-wrapper {
        max-width: 800px;
        width: 100%;
        margin: 2.5rem auto;
        padding: 0 1.25rem;
        flex: 1;
      }

      .article-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 3rem 2.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      }

      /* Хлебные крошки */
      .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
      }
      .breadcrumbs a {
        color: var(--forest-accent);
        text-decoration: none;
        font-weight: 600;
      }
      .breadcrumbs a:hover {
        text-decoration: underline;
      }

      .article-header {
        margin-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.75rem;
      }
      .badge {
        display: inline-block;
        background: var(--forest-light);
        color: var(--forest-accent);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.3rem 0.75rem;
        border-radius: 6px;
        letter-spacing: 0.06em;
      }
      .date {
        color: #71717a;
        font-size: 0.9rem;
        margin-left: 0.75rem;
      }
      h1 {
        font-size: 2.35rem;
        line-height: 1.25;
        margin: 1.25rem 0 0.5rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #09090b;
      }

      /* Текст и контент */
      article p {
        margin-bottom: 1.6rem;
      }
      article h2 {
        font-size: 1.6rem;
        margin: 2.5rem 0 1rem;
        color: #09090b;
        letter-spacing: -0.015em;
      }
      article h3 {
        font-size: 1.25rem;
        margin: 2rem 0 0.75rem;
        color: #18181b;
      }
      article img {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        margin: 2rem 0 0.5rem;
      }
      article em {
        display: block;
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 1.75rem;
      }
      article table {
        width: 100%;
        border-collapse: collapse;
        margin: 2.5rem 0;
        font-size: 0.95rem;
      }
      article th, article td {
        border: 1px solid var(--border);
        padding: 0.85rem 1.15rem;
        text-align: left;
      }
      article th {
        background: #f4f4f5;
        font-weight: 600;
      }
      article blockquote {
        border-left: 4px solid var(--forest-accent);
        padding: 1rem 1.4rem;
        margin: 2rem 0;
        background: #f0fdf4;
        border-radius: 0 10px 10px 0;
      }

      /* Паучок «Наверх» */
      #back-to-top {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 50;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: transparent;
        border: none;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.2s ease;
      }
      #back-to-top.visible {
        opacity: 1;
        visibility: visible;
      }
      #back-to-top:hover {
        transform: translateY(-6px);
      }
      .spider-web-thread {
        width: 2px;
        height: 45px;
        background: linear-gradient(to bottom, rgba(148, 163, 184, 0.2), rgba(148, 163, 184, 0.7));
      }
      .spider-icon {
        font-size: 1.9rem;
        line-height: 1;
        filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.2));
      }

      /* Подвал */
      .site-footer {
        background: #0f172a;
        color: #94a3b8;
        padding: 3.5rem 1.5rem 2.5rem;
        margin-top: 5rem;
        border-top: 1px solid #1e293b;
      }
      .footer-container {
        max-width: 860px;
        margin: 0 auto;
        text-align: center;
      }
      .footer-brand {
        font-size: 1.35rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
      }
      .footer-tagline {
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 1.75rem;
      }
      .footer-links {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
      }
      .footer-links a {
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.9rem;
        transition: color 0.15s;
      }
      .footer-links a:hover {
        color: #34d399;
      }
      .footer-copy {
        font-size: 0.825rem;
        color: #64748b;
        margin: 0;
      }

      @media (max-width: 640px) {
        body {
          font-size: 1.05rem;
          line-height: 1.75;
        }
        .article-card {
          padding: 1.75rem 1.15rem;
          border: none;
          box-shadow: none;
          background: transparent;
        }
        .header-container {
          flex-direction: column;
          gap: 0.85rem;
          text-align: center;
        }
        #back-to-top {
          bottom: 1rem;
          right: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Верхняя шапка сайта с брендом -->
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="brand">
          <div class="brand-spider-badge">
            <span class="spider-glyph">🕷️</span>
          </div>
          <div class="brand-divider"></div>
          <div class="brand-text-block">
            <div class="brand-title">Bioactive Spiders</div>
            <div class="brand-tagline">Engineered Vivarium Care</div>
          </div>
        </a>
        <nav class="nav-links">
          <a href="/">Home</a>
          <a href="/enclosure-setup/">Enclosures</a>
          <a href="/microfauna/">Microfauna</a>
        </nav>
      </div>
    </header>

    <div class="page-wrapper">
      <div class="article-card">
        <!-- Хлебные крошки -->
        <nav class="breadcrumbs">
          <a href="/">Home</a>
          <span>/</span>
          <span>{data.category}</span>
        </nav>

        <div class="article-header">
          <div>
            <span class="badge">{data.category}</span>
            <time class="date">{new Date(data.pubDate).toLocaleDateString('en-US', { dateStyle: 'medium' })}</time>
          </div>
          <h1>{data.title}</h1>
        </div>

        <main>
          <article>
            <slot />
          </article>
        </main>
      </div>
    </div>

    <!-- Интерактивный паучок «Наверх» -->
    <button id="back-to-top" aria-label="Back to top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});">
      <div class="spider-web-thread"></div>
      <div class="spider-icon">🕷️</div>
    </button>

    <!-- Солидный темный подвал -->
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-brand">🕷️ Bioactive Spiders</div>
        <div class="footer-tagline">The definitive technical resource for living vivariums and jumping spider welfare.</div>
        <div class="footer-links">
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
          <a href="/disclaimer/">Care Disclaimer</a>
          <a href="/about/">About Us</a>
        </div>
        <p class="footer-copy">© 2026 Bioactive Spiders. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('back-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          btn?.classList.add('visible');
        } else {
          btn?.classList.remove('visible');
        }
      });
    </script>
  </body>
</html>
