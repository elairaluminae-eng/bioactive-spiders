---
interface Props {
  content?: {
    title: string;
    description: string;
    pubDate: string;
    updatedDate?: string;
    category: string;
    tags?: string[];
    schemaType?: string;
  };
  frontmatter?: Props['content'];
}

const { frontmatter, content } = Astro.props;
const data = frontmatter || content;

if (!data) {
  throw new Error("No frontmatter provided to ArticleLayout");
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://bioactive-spiders.pages.dev');
const publishDate = new Date(data.pubDate).toISOString();

const schemaJson = {
  "@context": "https://schema.org",
  "@type": data.schemaType || "Article",
  "headline": data.title,
  "description": data.description,
  "datePublished": publishDate,
  "dateModified": data.updatedDate ? new Date(data.updatedDate).toISOString() : publishDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.href
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.title} | Bioactive Spider Care</title>
    <meta name="description" content={data.description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Фавикон во вкладке браузера (паучок) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🕷️</text></svg>" />

    <!-- Open Graph -->
    <meta property="og:title" content={data.title} />
    <meta property="og:description" content={data.description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="article" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

    <style>
      :root {
        --text-main: #1f2937;
        --text-muted: #4b5563;
        --accent: #15803d;
        --accent-hover: #166534;
        --accent-light: #dcfce7;
        --border: #e5e7eb;
        --bg: #ffffff;
      }
      
      html {
        scroll-behavior: smooth;
      }

      body {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.25rem 1.5rem;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.75;
        color: var(--text-main);
        background: var(--bg);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      /* Хлебные крошки (Breadcrumbs) */
      .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
      }
      .breadcrumbs a {
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
      }
      .breadcrumbs a:hover {
        text-decoration: underline;
      }

      header {
        margin-bottom: 2.5rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.75rem;
      }
      .badge {
        display: inline-block;
        background: var(--accent-light);
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.25rem 0.65rem;
        border-radius: 4px;
        letter-spacing: 0.05em;
      }
      .date {
        color: #6b7280;
        font-size: 0.875rem;
        margin-left: 0.75rem;
      }
      h1 {
        font-size: 2.25rem;
        line-height: 1.25;
        margin: 1.25rem 0 0.5rem;
        font-weight: 800;
        color: #111827;
      }

      main {
        flex: 1;
      }

      /* Форматирование статей */
      article img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1.5rem 0 0.5rem;
      }
      article em {
        display: block;
        color: var(--text-muted);
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
      }
      article table {
        width: 100%;
        border-collapse: collapse;
        margin: 2rem 0;
      }
      article th, article td {
        border: 1px solid var(--border);
        padding: 0.75rem 1rem;
        text-align: left;
      }
      article th {
        background: #f9fafb;
        font-weight: 600;
      }
      article blockquote {
        border-left: 4px solid var(--accent);
        padding: 0.75rem 1.25rem;
        margin: 1.5rem 0;
        background: #f0fdf4;
        border-radius: 0 6px 6px 0;
      }

      /* Интерактивный паучок «Наверх» */
      #back-to-top {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 50;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: transparent;
        border: none;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.2s ease;
      }
      #back-to-top.visible {
        opacity: 1;
        visibility: visible;
      }
      #back-to-top:hover {
        transform: translateY(-4px);
      }
      .spider-web {
        width: 1px;
        height: 35px;
        background: linear-gradient(to bottom, transparent, rgba(100, 116, 139, 0.4));
      }
      .spider-icon {
        font-size: 1.6rem;
        line-height: 1;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
      }

      /* Подвал */
      footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        font-size: 0.875rem;
        color: #6b7280;
        text-align: center;
      }
      .footer-links {
        margin-bottom: 0.75rem;
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
      .footer-links a {
        color: #4b5563;
        text-decoration: none;
      }
      .footer-links a:hover {
        color: var(--accent);
      }

      @media (max-width: 640px) {
        #back-to-top {
          bottom: 1rem;
          right: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- Хлебные крошки -->
    <nav class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <span>{data.category}</span>
    </nav>

    <header>
      <div>
        <span class="badge">{data.category}</span>
        <time class="date">{new Date(data.pubDate).toLocaleDateString('en-US', { dateStyle: 'medium' })}</time>
      </div>
      <h1>{data.title}</h1>
    </header>

    <main>
      <article>
        <slot />
      </article>
    </main>

    <!-- Кнопка наверх с паучком -->
    <button id="back-to-top" aria-label="Back to top" onclick="window.scrollTo({top: 0, behavior: 'smooth'});">
      <div class="spider-web"></div>
      <div class="spider-icon">🕷️</div>
    </button>

    <footer>
      <div class="footer-links">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
        <a href="/disclaimer/">Care Disclaimer</a>
        <a href="/about/">About Us</a>
      </div>
      <p>© 2026 Bioactive Spiders. Engineered natural vivariums & jumping spider welfare.</p>
    </footer>

    <script>
      const btn = document.getElementById('back-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          btn?.classList.add('visible');
        } else {
          btn?.classList.remove('visible');
        }
      });
    </script>
  </body>
</html>
